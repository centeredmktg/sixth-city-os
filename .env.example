# Copy to .env for local dev. Railway vars in prod (same pattern as sows/).
# Empty HUBSPOT_TOKEN = dry mode: the engine logs what it would do, writes nothing.

HUBSPOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=

# Data-source keys (see engine/sources/SOURCES.md). Fill as each is wired.
GOOGLE_PLACES_KEY=
PAGESPEED_KEY=
BUILTWITH_KEY=
APOLLO_KEY=
