# Copy to .env for local dev. Railway vars in prod (same pattern as sows/).
# Empty HUBSPOT_TOKEN = dry mode: the engine logs what it would do, writes nothing.

HUBSPOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=

# Data-source keys (see engine/sources/SOURCES.md). Fill as each is wired.
GOOGLE_PLACES_KEY=
PAGESPEED_KEY=
BUILTWITH_KEY=
APOLLO_KEY=

# Google-OAuth gate (web/auth.py). Set ALL THREE in prod (Railway) to enforce sign-in.
# Leave blank for local dev/tests -> gate is OPEN (no login). Setup steps: web/auth.py docstring.
#   ID + SECRET come from GCP Console -> APIs & Services -> Credentials -> OAuth client ID (Web app).
#   Redirect URI must be EXACTLY: https://sixth-city-os-production.up.railway.app/auth/callback
#   SESSION_SECRET = any long random string: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# Optional allowlist overrides (defaults: domain sixthcitymarketing.com, email dcox@centeredmktg.com)
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Direct-path admin backfill (web/auth.py) — username/password login at /auth/admin,
# reachable only by direct URL (not linked from the Google page). TEMPORARY — remove once a
# Sixth City Google account exists. Store the SHA-256 hex of the password, never plaintext:
#   python3 -c "import hashlib;print(hashlib.sha256(b'YOURPW').hexdigest())"
ADMIN_USER=
ADMIN_PASSWORD_HASH=
